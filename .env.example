# ─────────────────────────────────────────────
# Variáveis de Ambiente — commerce-ms
# Copie este arquivo para .env e preencha os valores
# NUNCA envie o .env para o git
# ─────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=commerce
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=commerce

# ── Redis ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth Service ────────────────────────────
AUTH_PORT=8081
# Tempo de vida do access token (em minutos)
JWT_ACCESS_TTL_MINUTES=15
# Tempo de vida do refresh token (em dias)
JWT_REFRESH_TTL_DAYS=7
# Argon2id — custo de memória em KB (64MB = 65536)
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# ── Catalog Service ─────────────────────────
CATALOG_PORT=8082

# ── Order Service ───────────────────────────
ORDER_PORT=8083
# TTL do carrinho no Redis (em segundos — 30min = 1800)
CART_TTL_SECONDS=1800

# ── Payment Service ─────────────────────────
PAYMENT_PORT=8084
# Chave usada para validar assinatura HMAC dos webhooks de pagamento
PAYMENT_WEBHOOK_SECRET=troque_este_segredo

# ── Notify Service ──────────────────────────
NOTIFY_PORT=8085
# URL do n8n (instância local ou cloud)
N8N_BASE_URL=http://localhost:5678
# Chave usada para assinar webhooks enviados ao n8n
N8N_WEBHOOK_SECRET=troque_este_segredo

# ── API Gateway ─────────────────────────────
GATEWAY_PORT=8080
# Caminho para a chave pública JWT (RS256)
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# ── Geral ───────────────────────────────────
# Ambiente: development | staging | production
APP_ENV=development
LOG_LEVEL=debug

